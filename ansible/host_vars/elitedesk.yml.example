---
# Copy to elitedesk.yml, set the password, then encrypt with ansible-vault.
# The filename must match the inventory alias, not the hostname or IP address.
compose_pihole_password: ""

# Optional per-host overrides (see roles/compose/defaults/main.yml):
# homelab_hostname: elitedesk
# compose_timezone: Europe/Stockholm
# compose_website_image: ghcr.io/msegers/mathijs.se:0.0.5
# compose_pihole_domain: dns.home.example
# compose_host_ip defaults to ansible_host; no duplicate IP setting is needed.
