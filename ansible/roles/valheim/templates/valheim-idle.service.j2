[Unit]
Description=Stop Valheim after confirmed player inactivity
After=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/homelab-valheim/valheim-control --config {{ valheim_state_dir }}/config.json idle
TimeoutStartSec={{ (valheim_stop_timeout | int) + 180 }}
UMask=0077
NoNewPrivileges=true
