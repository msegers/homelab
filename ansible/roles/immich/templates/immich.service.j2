[Unit]
Description=Private Immich Compose stack
Requires=docker.service
After=docker.service srv-storage.mount
RequiresMountsFor=/srv/storage
BindsTo=srv-storage.mount
PartOf=docker.service

[Service]
Type=simple
WorkingDirectory={{ immich_project_dir }}
ExecStartPre=/usr/bin/findmnt --noheadings --mountpoint /srv/storage --source UUID={{ nas_storage_expected_uuid }} --types ext4 --options rw
ExecStart=/usr/bin/docker compose --project-directory {{ immich_project_dir }} up --abort-on-container-failure --remove-orphans
ExecStop=/usr/bin/docker compose --project-directory {{ immich_project_dir }} down --timeout 120
Restart=on-failure
RestartSec=10
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
