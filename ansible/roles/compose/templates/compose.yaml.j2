name: homelab

services:
  proxy:
{% if compose_private_tls_enabled | bool %}
    build:
      context: .
      dockerfile: Dockerfile.caddy
    image: homelab-caddy-cloudflare:{{ compose_caddy_cloudflare_version }}
{% else %}
    image: {{ compose_caddy_image | to_json | replace('$', '$$') }}
{% endif %}
    restart: unless-stopped
    ports:
      - {{ (compose_bind_ip ~ ':80:80') | to_json | replace('$', '$$') }}
      - {{ (compose_bind_ip ~ ':443:443') | to_json | replace('$', '$$') }}
    environment:
{% if compose_private_tls_enabled | bool %}
      CF_API_TOKEN: {{ compose_cloudflare_api_token | to_json | replace('$', '$$') }}
{% endif %}
      WEBSITE_DOMAIN: {{ compose_website_domain | to_json | replace('$', '$$') }}
      WEBSITE_WWW_DOMAIN: {{ compose_website_www_domain | to_json | replace('$', '$$') }}
      PIHOLE_DOMAIN: {{ compose_pihole_domain | to_json | replace('$', '$$') }}
      PIHOLE_ALLOWED_NETWORKS: {{ compose_pihole_allowed_networks | join(' ') | to_json | replace('$', '$$') }}
{% if compose_home_tools_enabled | bool %}
      HOME_TOOLS_DOMAIN: {{ compose_home_tools_domain | to_json | replace('$', '$$') }}
      HOME_TOOLS_ALLOWED_NETWORKS: {{ compose_home_tools_allowed_networks | join(' ') | to_json | replace('$', '$$') }}
      HOME_TOOLS_UPSTREAM: {{ (compose_bind_ip ~ ':' ~ (compose_home_tools_port | int)) | to_json | replace('$', '$$') }}
{% endif %}
{% if compose_immich_enabled | bool %}
      IMMICH_DOMAIN: {{ compose_immich_domain | to_json }}
      IMMICH_ALLOWED_NETWORKS: {{ compose_immich_allowed_networks | join(' ') | to_json }}
{% endif %}
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - website
      - pihole

  website:
    image: {{ compose_website_image | to_json | replace('$', '$$') }}
    restart: unless-stopped

  pihole:
    image: {{ compose_pihole_image | to_json | replace('$', '$$') }}
    restart: unless-stopped
    ports:
      - {{ (compose_bind_ip ~ ':53:53/tcp') | to_json | replace('$', '$$') }}
      - {{ (compose_bind_ip ~ ':53:53/udp') | to_json | replace('$', '$$') }}
    environment:
      TZ: {{ compose_timezone | to_json | replace('$', '$$') }}
      FTLCONF_webserver_api_password: {{ compose_pihole_password | to_json | replace('$', '$$') }}
      FTLCONF_dns_listeningMode: ALL
      FTLCONF_dns_upstreams: {{ compose_pihole_upstreams | to_json | replace('$', '$$') }}
{% if compose_pihole_local_hosts is not none %}
      FTLCONF_dns_hosts: {{ compose_pihole_local_hosts | join(';') | to_json | replace('$', '$$') }}
{% endif %}
    volumes:
      - pihole_data:/etc/pihole

volumes:
  pihole_data:
  caddy_data:
  caddy_config:
