RESTIC_REPOSITORY={{ offsite_backup_repository | to_json }}
RESTIC_REST_USERNAME={{ offsite_backup_username | to_json }}
RESTIC_REST_PASSWORD={{ offsite_backup_http_password | to_json(ensure_ascii=False) }}
RESTIC_PASSWORD_FILE=/etc/homelab-offsite-backup/password
RESTIC_CACHE_DIR=/var/lib/homelab-offsite-backup
{% if offsite_backup_ca | length > 0 %}
RESTIC_CACERT=/etc/homelab-offsite-backup/ca.pem
{% endif %}
