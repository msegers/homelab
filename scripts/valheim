#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: $0 {start|stop|restart|status|backup|update|world NAME|worlds|retire} [Ansible options]" >&2
  exit 2
}

[[ $# -ge 1 ]] || usage
action=$1
shift
case "$action" in
  start|stop|restart|status|backup|update|worlds|retire) extra="valheim_action=$action" ;;
  world)
    [[ $# -ge 1 && $1 =~ ^[A-Za-z0-9_][A-Za-z0-9_-]*$ ]] || usage
    extra="valheim_action=world valheim_selected_world=$1"
    shift
    ;;
  *) usage ;;
esac

# Reuse inventory.ini / ansible.cfg and Vault, never a separate .env file.
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root/ansible"
vault_args=()
if [[ -z ${ANSIBLE_VAULT_PASSWORD_FILE:-} && -z ${ANSIBLE_VAULT_IDENTITY_LIST:-} ]]; then
  vault_args=(--ask-vault-pass)
  for option in "$@"; do
    case "$option" in
      --vault-password-file*|--vault-id*|--ask-vault-pass*) vault_args=(); break ;;
    esac
  done
fi
exec ansible-playbook valheim.yml --extra-vars "$extra" "${vault_args[@]}" "$@"
